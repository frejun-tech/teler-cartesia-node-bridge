# Server Configuration
PORT=8000
NODE_ENV=development
SERVER_DOMAIN=localhost:8000

# Teler Integration
# API key for Teler voice platform
TELER_API_KEY=your_teler_api_key_here

# Audio format for Teler
# Sample rate: typically "16k" for 16kHz
TELER_SAMPLE_RATE=16k

TELER_CHUNK_SIZE=400

# Cartesia Integration
# Agent ID from your Cartesia workspace
CARTESIA_AGENT_ID=your_cartesia_agent_id_here

# Cartesia API base URL (without https://)
# Example: api.cartesia.ai
CARTESIA_BASE_URL=api.cartesia.ai

# API key for Cartesia authentication
CARTESIA_API_KEY=your_cartesia_api_key_here

# Sample rate for Cartesia audio processing
# Must be 16000 Hz (16kHz) - matched with input/output format in agent config
CARTESIA_SAMPLE_RATE=16000

# Message buffer size for Cartesia stream
# Controls how many messages are buffered before processing
CARTESIA_MESSAGE_BUFFER_SIZE=10

# System prompt for the Cartesia agent
# Customizes the agent's behavior and response style
CARTESIA_SYSTEM_PROMPT=You are a helpful and friendly voice assistant. Keep your responses concise, natural, and conversational. Speak clearly and at a moderate pace.
